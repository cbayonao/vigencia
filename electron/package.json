{
  "name": "vigencia",
  "productName": "Vigencia",
  "version": "3.7.0",
  "private": true,
  "description": "Consulta local de procesos. La base sqlite no sale del computador.",
  "main": "src/main.js",
  "type": "module",
  "author": "Vigencia <vigencia@localhost>",
  "homepage": "https://vigencia.local",
  "desktopName": "vigencia",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:linux": "electron-builder --linux AppImage deb",
    "postdist:linux": "node script/verificar-motor.mjs dist/linux-unpacked linux-x64",
    "dist:win": "node script/traer-win.mjs && node script/nsis-sin-wine.mjs && electron-builder --win nsis",
    "postdist:win": "node script/verificar-motor.mjs dist/win-unpacked win-x64",
    "dist:mac": "electron-builder --mac dmg",
    "postdist:mac": "node script/verificar-motor.mjs dist mac-arm64-metal",
    "editor": "esbuild editor/editor.js --bundle --format=esm --minify --legal-comments=eof --outfile=renderer/vendor/editor.js",
    "visor": "esbuild visor/visor.js --bundle --format=esm --minify --legal-comments=eof --outfile=renderer/vendor/visor.js && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs renderer/vendor/pdf.worker.min.mjs"
  },
  "build": {
    "appId": "co.vigencia.app",
    "productName": "Vigencia",
    "executableName": "vigencia",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins/**/*",
      "node_modules/@node-llama-cpp/*/bins/**/*",
      "node_modules/@node-llama-cpp/*/dist/**/*",
      "node_modules/@node-llama-cpp/*/package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "compartido/**/*",
      "package.json",
      "node_modules/node-llama-cpp/**/*",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!node_modules/node-llama-cpp/llama/localBuilds/**",
      "!node_modules/node-llama-cpp/llama/addon/**",
      "node_modules/@node-llama-cpp/linux-x64/**/*",
      "node_modules/@node-llama-cpp/win-x64/**/*",
      "node_modules/@node-llama-cpp/mac-arm64-metal/**/*",
      "node_modules/@node-llama-cpp/mac-x64/**/*",
      "!node_modules/@node-llama-cpp/linux-arm64/**/*",
      "!node_modules/@node-llama-cpp/linux-armv7l/**/*",
      "!node_modules/@node-llama-cpp/linux-x64-cuda*/**/*",
      "!node_modules/@node-llama-cpp/linux-x64-vulkan/**/*",
      "!script/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Vigencia.${ext}",
      "synopsis": "Consulta local de procesos judiciales",
      "maintainer": "Vigencia <vigencia@localhost>",
      "syncDesktopName": true,
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Vigencia-Setup.${ext}",
      "signAndEditExecutable": false,
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Vigencia"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Vigencia.${ext}",
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "tesseract.js": "^6.0.1"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "turndown": "^7.2.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "node-llama-cpp@3.22.1": true
  }
}
