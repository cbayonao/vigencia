  <svg viewBox="0 0 32 32" class="w-8 h-8 fill-white" aria-hidden="true"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 2 6.5L4 29l7.7-2c1.8 1 3.9 1.6 6.1 1.6h.2c6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.9h-.2c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-4.6 1.2 1.2-4.4-.3-.4c-1.1-1.7-1.6-3.6-1.6-5.6C4.9 9.6 9.6 4.9 16 4.9S27.1 9.6 27.1 16 22.4 24.9 16 24.9z"/></svg>
</a>

<script>
  // Aparecer al hacer scroll
  const piezas = document.querySelectorAll('.revelar:not(.visible)');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.15 });
    piezas.forEach((el) => obs.observe(el));
  } else {
    piezas.forEach((el) => el.classList.add('visible'));
  }

  // Detectar el sistema para el botón principal
  const ua = navigator.userAgent;
  const txt = document.getElementById('cta-hero-texto');
  const aviso = document.getElementById('aviso-so');
  let so = 'un sistema que no reconocimos. Escoge abajo el instalador';
  if (/Windows/i.test(ua)) { txt.textContent = 'Descargar para Windows'; so = 'Windows. Te sirve el .exe'; }
  else if (/Linux/i.test(ua)) { txt.textContent = 'Descargar para Linux'; so = 'Linux. Puedes usar el AppImage o el .deb'; }
  else if (/Mac/i.test(ua)) { txt.textContent = 'Ver la descarga para Mac'; so = 'Mac. Mira abajo la tarjeta de Mac'; }
  aviso.textContent = 'Estás en ' + so;
</script>
</body>
</html>
