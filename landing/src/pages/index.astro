<script>
  // reveal on scroll
  const obs = new IntersectionObserver((es) => {
    es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.revelar:not(.visible)').forEach(el => obs.observe(el));

  // contadores
  const cObs = new IntersectionObserver((es) => {
    es.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target; cObs.unobserve(el);
      const meta = parseInt(el.dataset.meta || '0', 10);
      const t0 = performance.now(), dur = 1400;
      const paso = (t) => {
        const p = Math.min(1, (t - t0) / dur);
        el.textContent = String(Math.round(meta * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.contador').forEach(el => cObs.observe(el));

  // detectar SO para el CTA del hero
  const ua = navigator.userAgent;
  const txt = document.getElementById('cta-hero-texto');
  const aviso = document.getElementById('aviso-so');
  let so = 'tu equipo';
  if (/Windows/i.test(ua)) { txt.textContent = 'Descargar para Windows (.exe)'; so = 'Windows — te recomendamos el .exe'; }
  else if (/Linux/i.test(ua)) { txt.textContent = 'Descargar AppImage para Linux'; so = 'Linux — te recomendamos el AppImage o el .deb'; }
  else if (/Mac/i.test(ua)) { txt.textContent = 'Descargar (Mac en camino)'; so = 'Mac — la tuya está en camino; mientras tanto usa Windows o Linux'; }
  aviso.textContent = '📍 Estás en ' + so;

  // memorial demo escribiéndose solo
  const frases = [
    'Señor Juez Segundo Civil del Circuito… ',
    'ref: contestación de la demanda… ',
    'PRIMERO: me opongo a las pretensiones… ',
    'SEGUNDO: adjunto poder y certificado… ✓ listo para Word y PDF.',
  ];
  const demo = document.getElementById('demo-escrito');
  let fi = 0, ci = 0, actual = '';
  function escribirDemo() {
    if (!demo) return;
    const f = frases[fi];
    actual += f[ci++];
    demo.textContent = actual.slice(-110);
    if (ci >= f.length) {
      ci = 0; fi = (fi + 1) % frases.length;
      if (fi === 0) actual = '';
      setTimeout(escribirDemo, 1400);
    } else {
      setTimeout(escribirDemo, 34);
    }
  }
  escribirDemo();
</script>
