---
import "../styles/global.css";
import { VERSION, PRECIO, DIAS_PRUEBA, WHATSAPP, MENSAJE_WHATSAPP, BASE_DESCARGAS, ARCHIVOS } from "../data.ts";
import { existsSync } from "node:fs";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";
const enlaceWhatsapp = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(MENSAJE_WHATSAPP)}`;
const numeroVisible = `+${WHATSAPP.slice(0,2)} ${WHATSAPP.slice(2,5)} ${WHATSAPP.slice(5,8)} ${WHATSAPP.slice(8)}`;

const titulo = "VigencIA, seguimiento de tus procesos en la Rama Judicial";
// La tarjeta de Mac activa sola la descarga cuando el último release de
// GitHub ya trae el .dmg. Sin red o sin permiso, mira el archivo local.
async function macEnRelease() {
  try {
    const cabeceras = {
      "User-Agent": "vigencia-landing",
      Accept: "application/vnd.github+json",
    };
    const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;
    if (token) cabeceras.Authorization = `Bearer ${token}`;
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 8000);
    const r = await fetch("https://api.github.com/repos/cbayonao/vigencia/releases/latest", {
      headers: cabeceras,
      signal: ctrl.signal,
    });
    clearTimeout(t);
    if (!r.ok) return null;
    const j = await r.json();
    return (j.assets || []).some((a) => a.name === ARCHIVOS.mac);
  } catch {
    return null;
  }
}
const raizRepo = join(dirname(fileURLToPath(import.meta.url)), "..", "..", "..");
const macLista = (await macEnRelease()) ?? existsSync(join(raizRepo, ARCHIVOS.mac));
